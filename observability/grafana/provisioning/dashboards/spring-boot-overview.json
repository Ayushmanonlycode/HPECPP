{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Microservices Showdown — Spring Boot vs WildFly performance comparison dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HTTP Throughput & Error Rate",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring-boot-services\"}[1m])) by (uri)",
          "legendFormat": "SB — {{uri}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"wildfly-services\"}[1m])) by (uri)",
          "legendFormat": "WF — {{uri}}",
          "refId": "B"
        }
      ],
      "title": "Request Rate (req/s) — by URI",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring-boot-services\",outcome=\"SERVER_ERROR\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"spring-boot-services\"}[1m]))",
          "legendFormat": "Spring Boot Error Rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"wildfly-services\",outcome=\"SERVER_ERROR\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"wildfly-services\"}[1m]))",
          "legendFormat": "WildFly Error Rate",
          "refId": "B"
        }
      ],
      "title": "Error Rate (5xx / total)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Response Time Percentiles (P50 / P95 / P99)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=\"spring-boot-services\"}[1m])) by (le))",
          "legendFormat": "SB P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"spring-boot-services\"}[1m])) by (le))",
          "legendFormat": "SB P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"spring-boot-services\"}[1m])) by (le))",
          "legendFormat": "SB P99",
          "refId": "C"
        }
      ],
      "title": "Spring Boot — Response Time Percentiles",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=\"wildfly-services\"}[1m])) by (le))",
          "legendFormat": "WF P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"wildfly-services\"}[1m])) by (le))",
          "legendFormat": "WF P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"wildfly-services\"}[1m])) by (le))",
          "legendFormat": "WF P99",
          "refId": "C"
        }
      ],
      "title": "WildFly — Response Time Percentiles",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "JVM Memory (Heap) — Spring Boot",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"spring-boot-services\",area=\"heap\"}) by (instance)",
          "legendFormat": "{{instance}} heap used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{job=\"spring-boot-services\",area=\"heap\"}) by (instance)",
          "legendFormat": "{{instance}} heap max",
          "refId": "B"
        }
      ],
      "title": "Spring Boot — JVM Heap Used vs Max",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=\"spring-boot-services\"}[1m])",
          "legendFormat": "{{instance}} GC pause/s",
          "refId": "A"
        }
      ],
      "title": "Spring Boot — GC Pause Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Container Resources (cAdvisor)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"sb-.*\"}[1m])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Spring Boot — Container CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 8,
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name=~\"sb-.*\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Spring Boot — Container Memory (Working Set)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["showdown", "spring-boot", "wildfly", "performance"],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Microservices Showdown — Performance Overview",
  "uid": "showdown-perf-overview",
  "version": 1
}
