# =============================================================================
# Microservices Showdown — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values before running docker compose.
# The .env file is in .gitignore and must NEVER be committed.
# =============================================================================

# ── Shared database credentials ───────────────────────────────────────────────
DB_USER=
DB_PASSWORD=

# ── Grafana admin credentials ─────────────────────────────────────────────────
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ── Keycloak admin credentials ────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# ── Keycloak client secret (must match keycloak/realm-export.json) ────────────
KEYCLOAK_CLIENT_SECRET=
